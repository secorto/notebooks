   "source": [
    "# Programación orientada a objetos en Python\n",
    "\n",
    "Conceptos básicos de clases y objetos."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class Coche:\n",
    "    def __init__(self, marca):\n",
    "        self.marca = marca\n",
    "\n",
    "    def describir(self):\n",
    "        return f'Marca: {self.marca}'\n",
    "\n",
    "c = Coche('Tesla')\n",
    "print(c.describir())\n"
   ]
  }
